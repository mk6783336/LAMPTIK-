{
  "manifest_version": 3,
  "name": "LampTik — Downloader for YouTube, TikTok & Reels",
  "version": "1.0.0",
  "description": "Save YouTube, TikTok, Instagram and Facebook videos as MP4 or MP3 with one click — powered by lamptik.online. Free, no account, no watermark.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "https://www.lamptik.online/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LampTik downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
