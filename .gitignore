# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
.scratch/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# local run logs (dev server / build output, regenerable)
*.log
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# screenshots (dev/QA captures, not source)
/screenshots/

# built Android APK — served from the public `latest-apk` GitHub release, not
# from git (a 23 MB binary per build would bloat history for no gain)
/public/downloads/*.apk

# IndexNow content hashes — restored between workflow runs by actions/cache,
# never a source file (a stale committed copy would suppress real submissions)
.indexnow-state.json

# freebuff tooling metadata
.freebuff/

# typescript
*.tsbuildinfo

.vercel
.env*

# python
__pycache__/
*.pyc
.index-check-state.json
