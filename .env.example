# ---------------------------------------------------------------------------
# Public origin — canonical URLs, sitemap, robots, social metadata.
# The production fallback (used when this is unset) is https://www.lamptik.online.
# Only set this for staging/preview origins; never leave localhost in prod.
# NEXT_PUBLIC_SITE_URL=https://www.lamptik.online

# ---------------------------------------------------------------------------
# Monetization (optional — the app ships completely ad-free until these are set).
#
# Nothing below is required. With every value empty the site loads zero ad
# scripts, renders zero ad containers, and the CSP stays pure 'self'.
#
# Adsterra ---------------------------------------------------------------
# Banner key from the dashboard's "Banner" / invoke.js tag (the token in
# https://www.highperformanceformat.com/<KEY>/invoke.js).
# NEXT_PUBLIC_ADSTERRA_BANNER_KEY=0123456789abcdef0123456789abcdef
# Optional: override the serving host if your account uses a different one.
# NEXT_PUBLIC_ADSTERRA_BANNER_SRC=https://www.highperformanceformat.com
# Optional: account id used to build the ads.txt record.
# NEXT_PUBLIC_ADSTERRA_ACCOUNT_ID=0000000
#
# Social Bar: paste the FULL script URL from the dashboard (account-specific).
# NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SRC=https://your-account-host.com/aa/bb/x.js
#
# Rectangle: the live 300x250 zone is already the built-in default, so slots
# render with no configuration. Only set this to rotate to a different zone —
# a leaderboard key will NOT work here, because Adsterra binds a key to a
# single creative size.
# NEXT_PUBLIC_ADSTERRA_RECT_KEY=f0075be743457b9b238d0d701fbd9d8b
# Publisher referral link (built-in default earns for this account).
# NEXT_PUBLIC_ADSTERRA_REFERRAL_URL=https://beta.publishers.adsterra.com/referral/1qm6LQfsaC
#
# Monetag ----------------------------------------------------------------
# Domain verification token: everything after `content="` in the meta tag the
# dashboard gives you. Renders <meta name="monetag" content="…"> in <head>.
# NEXT_PUBLIC_MONETAG_META=0123456789abcdef0123456789abcdef
#
# Vignette zone id (the `data-zone` value) + the script host from your tag.
# Optional — /sw.js is registered either way, and that is what verification
# and the push channel actually need.
# NEXT_PUBLIC_MONETAG_VIGNETTE_ZONE=1234567
# NEXT_PUBLIC_MONETAG_VIGNETTE_SRC=https://n6wxm.com/vignette.min.js
#
# SmartLink / direct link. Opened at most once per 10 minutes per session,
# only when a visitor starts a video download.
# NEXT_PUBLIC_MONETAG_SMARTLINK_URL=https://otieu.com/4/0000000
# Optional direct MP4 creative used in the every-third-video-download theater.
# NEXT_PUBLIC_VIDEO_AD_MP4_URL=https://cdn.example.com/sponsor-spotlight.mp4

# ads.txt records, semicolon-separated, exactly as the networks issue them.
# NEXT_PUBLIC_ADS_TXT_LINES=adsterra.com, 1234567, DIRECT; monetag.com, 7654321, DIRECT
# NEXT_PUBLIC_ADS_CONTACT_EMAIL=ads@example.com

# ---------------------------------------------------------------------------
# SEO (optional)
# Google Search Console verification token (HTML tag content).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# yt-dlp universal extractor (optional)
#
# Vercel's serverless runtime has no Python, so the strongest extractor
# (`yt-dlp --extractor-args "youtube:player_client=android"` — plus the
# tiktok/instagram/facebook flags for the universal tier) runs from a tiny
# self-hosted bridge container instead. Point this at an HTTP endpoint that
# accepts POST { url, platform } → JSON { url, duration, title, uploader,
# thumbnail, id } (bridge/app.py in this repo, or any `yt-dlp -j` wrapper).
# Unset = the extractor stays out of every platform waterfall entirely and
# the proven scrapers carry the load, unchanged.
# YTDLP_BRIDGE_URL=https://ytdlp.your-bridge.example/
#
# Shared secret the Next server sends as `x-bridge-secret` (≥24 random
# chars, matches BRIDGE_SECRET baked into the bridge container). Leave
# unset only while the bridge is reachable exclusively through your
# private tunnel.
# BRIDGE_SECRET=0123456789abcdef0123456789abcdef
#
# Self-hosted Node deployments can skip the bridge entirely: if the yt-dlp
# binary is on PATH, it is probed (once per 10 min) and used directly.
